{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/support", "destination": "/support.html" },
    { "source": "/email-confirmed", "destination": "/email-confirmed.html" },
    { "source": "/email-confirmed/:path*", "destination": "/email-confirmed.html" },
    { "source": "/auth/confirm", "destination": "/email-confirmed.html" },
    { "source": "/auth/confirm/:path*", "destination": "/email-confirmed.html" },
    { "source": "/auth/callback", "destination": "/email-confirmed.html" },
    { "source": "/auth/callback/:path*", "destination": "/email-confirmed.html" }
  ]
}

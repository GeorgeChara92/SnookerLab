{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/email-confirmed/:path*",
      "destination": "/email-confirmed"
    },
    {
      "source": "/auth/confirm",
      "destination": "/email-confirmed"
    },
    {
      "source": "/auth/confirm/:path*",
      "destination": "/email-confirmed"
    },
    {
      "source": "/auth/callback",
      "destination": "/email-confirmed"
    },
    {
      "source": "/auth/callback/:path*",
      "destination": "/email-confirmed"
    },
    {
      "source": "/auth/reset",
      "destination": "/reset"
    },
    {
      "source": "/auth/reset/:path*",
      "destination": "/reset"
    }
  ]
}

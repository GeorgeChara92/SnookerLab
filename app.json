{
  "expo": {
    "name": "Snooker Lab",
    "slug": "SnookerApp",
    "scheme": "snookerlab",
    "version": "1.0.0",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.georgechara.snookerlab",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Snooker Lab may access your location while using AR routine setup to improve motion tracking and camera alignment."
      }
    },
    "android": {
      "package": "com.georgechara.snookerlab",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "react-native-adapty",
      "@reactvision/react-viro",
      [
        "expo-camera",
        {
          "cameraPermission": "Snooker Lab uses the camera to help align table setup for routines."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4c8f03f4-ac0e-44e9-b5c0-45b32d3f23d1"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4c8f03f4-ac0e-44e9-b5c0-45b32d3f23d1"
    }
  }
}

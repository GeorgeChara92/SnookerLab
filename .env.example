# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional feature flags
EXPO_PUBLIC_ENABLE_AI_STORAGE_UPLOAD=1

# RevenueCat (set platform-specific keys)
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=

# RevenueCat entitlement ID (configured in dashboard)
EXPO_PUBLIC_RC_ENTITLEMENT_PRO=SnookerLab Pro

# RevenueCat product/package hint (optional but recommended)
EXPO_PUBLIC_RC_PRODUCT_MONTHLY=monthly

# Legacy tier keys (optional fallback)
EXPO_PUBLIC_RC_ENTITLEMENT_HALF_CENTURY=half_century
EXPO_PUBLIC_RC_ENTITLEMENT_CENTURY=century
EXPO_PUBLIC_RC_PRODUCT_HALF_CENTURY=
EXPO_PUBLIC_RC_PRODUCT_CENTURY=


# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional feature flags
EXPO_PUBLIC_ENABLE_AI_STORAGE_UPLOAD=1

# Adapty
EXPO_PUBLIC_ADAPTY_PUBLIC_SDK_KEY=
EXPO_PUBLIC_ADAPTY_PLACEMENT_ID=main_subscription
EXPO_PUBLIC_ADAPTY_ACCESS_LEVEL_PRO=SnookerLab Pro
EXPO_PUBLIC_ADAPTY_ACCESS_LEVEL_HALF_CENTURY=half_century
EXPO_PUBLIC_ADAPTY_ACCESS_LEVEL_CENTURY=century
EXPO_PUBLIC_ADAPTY_PRODUCT_MONTHLY=monthly
EXPO_PUBLIC_ADAPTY_PRODUCT_HALF_CENTURY=half_century_monthly
EXPO_PUBLIC_ADAPTY_PRODUCT_CENTURY=century_monthly

# Auth + account URLs
EXPO_PUBLIC_AUTH_REDIRECT_URL=snookerlab://auth/callback
EXPO_PUBLIC_AUTH_CONFIRM_REDIRECT_URL=https://snooker-lab.vercel.app/email-confirmed
EXPO_PUBLIC_PRIVACY_URL=https://snooker-lab.vercel.app/privacy
EXPO_PUBLIC_TERMS_URL=https://snooker-lab.vercel.app/terms
EXPO_PUBLIC_SUPPORT_EMAIL=support@snookerlab.app


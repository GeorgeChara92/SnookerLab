# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional feature flags
EXPO_PUBLIC_ENABLE_AI_STORAGE_UPLOAD=1

# RevenueCat
EXPO_PUBLIC_RC_IOS_PUBLIC_SDK_KEY=
EXPO_PUBLIC_RC_ANDROID_PUBLIC_SDK_KEY=
EXPO_PUBLIC_RC_OFFERING_ID=default
EXPO_PUBLIC_RC_ENTITLEMENT_PRO=SnookerLab Pro
EXPO_PUBLIC_RC_ENTITLEMENT_HALF_CENTURY=half_century
EXPO_PUBLIC_RC_ENTITLEMENT_CENTURY=century
EXPO_PUBLIC_RC_PRODUCT_MONTHLY=monthly
EXPO_PUBLIC_RC_PRODUCT_HALF_CENTURY=monthly_3_46
EXPO_PUBLIC_RC_PRODUCT_CENTURY=monthly_12

# Default subscription prices (fallback when RevenueCat pricing unavailable)
EXPO_PUBLIC_DEFAULT_PRICE_HALF_CENTURY=$3.49
EXPO_PUBLIC_DEFAULT_PRICE_CENTURY=$5.00

# Auth + account URLs
EXPO_PUBLIC_AUTH_REDIRECT_URL=snookerlab://auth/callback
EXPO_PUBLIC_AUTH_CONFIRM_REDIRECT_URL=https://snooker-lab.vercel.app/email-confirmed
EXPO_PUBLIC_PRIVACY_URL=https://snooker-lab.vercel.app/privacy
EXPO_PUBLIC_TERMS_URL=https://snooker-lab.vercel.app/terms
EXPO_PUBLIC_SUPPORT_EMAIL=support@snookerlab.app

